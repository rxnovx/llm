# Standalone / Termux: backend/.env overrides the shared root .env.
# Run python scripts/init_env.py --standalone at the repository root to create
# backend/.env and frontend/.env.local with generated secrets, preserving existing files.
APP_ENV=development
JWT_SECRET_KEY=
AUTH_PROXY_SECRET=
DATABASE_URL=sqlite:///./data/app.db
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=false
EXPOSE_DOCS=true
ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
PASSWORD_MIN_LENGTH=10
PUBLIC_REGISTRATION_ENABLED=true

# Core signup and password login work without email delivery or Google login.
# EMAIL_PROVIDER=console prints local verification/recovery links in the API terminal.
EMAIL_PROVIDER=disabled
EMAIL_VERIFICATION_REQUIRED=false
EXPOSE_AUTH_TOKENS_IN_RESPONSE=false
EMAIL_FROM=LLM <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=

# Random local replies; no model server needed. Disable for real-only deployment.
LLM_TEST_MODE=true
# Register servers here. The browser cannot provide an arbitrary upstream URL.
# vLLM base URL includes /v1; Ollama base URL is the server root.
# Example: [{"id":"office","name":"내부 모델","provider":"vllm","base_url":"http://192.168.0.10:8001/v1","model":"gpt-oss-120b","api_key":""}]
LLM_CONNECTIONS_JSON=[]

# Optional GitLab OAuth. See GITLAB_APPS.md; these secrets belong to the backend.
# Example: [{"id":"office","name":"사내 GitLab","base_url":"https://gitlab.example.internal","client_id":"application-id","secret_ref":"office"}]
GITLAB_INSTANCES_JSON=[]
GITLAB_CLIENT_SECRETS_JSON={}
INTEGRATIONS_ENCRYPTION_KEYS=[]
GITLAB_CA_BUNDLE=
GITLAB_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
LLM_PROVIDER_KEYS_JSON={}
LLM_USER_CONCURRENCY=1
LLM_USER_QUEUE_LIMIT=2
LLM_QUEUE_CAPACITY=50
LLM_QUEUE_WAIT_SECONDS=30

# Private MCP companion. Install requirements-terminal.txt only when using this feature.
TERMINAL_MCP_URL=
TERMINAL_SHARED_SECRET=
TERMINAL_EXECUTION_ENABLED=false
TERMINAL_AGENT_MAX_STEPS=12
TERMINAL_AGENT_TIMEOUT_SECONDS=600
TERMINAL_HOST=127.0.0.1
TERMINAL_PORT=8010
TERMINAL_BROKER_URL=http://127.0.0.1:8000
TERMINAL_EXECUTION_MODE=disabled
TERMINAL_WORKER_IMAGE=llm-terminal-worker:local
TERMINAL_WORKSPACE_HOST_PATH=
TERMINAL_JOB_TIMEOUT_SECONDS=300
TERMINAL_MAX_WORKSPACES_PER_USER=8
TERMINAL_WORKSPACE_TTL_SECONDS=86400
