# Standalone / Termux: backend/.env overrides the shared root .env.
# Run python scripts/init_env.py --standalone at the repository root to create
# backend/.env and frontend/.env.local with generated secrets, preserving existing files.
APP_ENV=development
JWT_SECRET_KEY=
AUTH_PROXY_SECRET=
DATABASE_URL=sqlite:///./data/app.db
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=false
EXPOSE_DOCS=true
ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
PASSWORD_MIN_LENGTH=10
PUBLIC_REGISTRATION_ENABLED=true

# Core signup and password login work without email delivery or Google login.
# EMAIL_PROVIDER=console prints local verification/recovery links in the API terminal.
EMAIL_PROVIDER=disabled
EMAIL_VERIFICATION_REQUIRED=false
EXPOSE_AUTH_TOKENS_IN_RESPONSE=false
EMAIL_FROM=LLM <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=
