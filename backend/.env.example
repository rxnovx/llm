# 개별 실행·Termux에서는 backend/.env가 루트의 공통 .env보다 우선합니다.
# 저장소 루트에서 python scripts/init_env.py --standalone을 실행하면 비밀 키를 생성하여
# backend/.env와 frontend/.env.local을 만듭니다. 기존 환경 파일은 덮어쓰지 않습니다.
APP_ENV=development
JWT_SECRET_KEY=
AUTH_PROXY_SECRET=
DATABASE_URL=sqlite:///./data/app.db
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=false
EXPOSE_DOCS=true
ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
PASSWORD_MIN_LENGTH=10
PUBLIC_REGISTRATION_ENABLED=true

# 기본 회원가입·비밀번호 로그인에는 이메일 발송이나 Google 로그인이 필요하지 않습니다.
# EMAIL_PROVIDER=console이면 로컬 인증·복구 링크를 API 터미널에 표시합니다.
EMAIL_PROVIDER=disabled
EMAIL_VERIFICATION_REQUIRED=false
EXPOSE_AUTH_TOKENS_IN_RESPONSE=false
EMAIL_FROM=LLM <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=

# true이면 모델 서버 없이 로컬 예시 답변을 제공합니다. 실제 모델만 사용할 때는 false로 설정하세요.
LLM_TEST_MODE=true
# 대화용 모델 서버를 등록합니다. 주소는 운영자가 설정하고 브라우저에서는 임의로 지정하지 못합니다.
# vLLM 기본 주소에는 /v1을 포함하고, Ollama는 서버 루트 주소를 사용합니다.
# 등록 예시: [{"id":"office","name":"내부 모델","provider":"vllm","base_url":"http://192.168.0.10:8001/v1","model":"gpt-oss-120b","api_key":""}]
LLM_CONNECTIONS_JSON=[]

# GitLab OAuth는 선택 기능입니다. GITLAB_APPS.md를 참고하고 비밀 값은 백엔드에만 보관하세요.
# OAuth 앱에 read_user read_api read_repository 권한을 등록하세요.
# 등록 예시: [{"id":"office","name":"사내 GitLab","base_url":"https://gitlab.example.internal","client_id":"application-id","secret_ref":"office"}]
# MR을 허용할 서버 항목에 "allow_publish": true를 추가하고 GitLab OAuth 앱에 api 권한을 등록하세요.
GITLAB_INSTANCES_JSON=[]
GITLAB_CLIENT_SECRETS_JSON={}
INTEGRATIONS_ENCRYPTION_KEYS=[]
GITLAB_CA_BUNDLE=
GITLAB_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
LLM_PROVIDER_KEYS_JSON={}
LLM_USER_CONCURRENCY=2
LLM_USER_QUEUE_LIMIT=2
LLM_QUEUE_CAPACITY=50
LLM_QUEUE_WAIT_SECONDS=30

# 비공개 Terminal MCP는 선택 기능입니다. 기본 설치에 원격 연결 클라이언트가 포함됩니다.
# 같은 환경의 MCP 서버 실행은 requirements-terminal.txt를 설치하세요. 자세한 내용은 TERMINAL_MCP.md에 있습니다.
TERMINAL_MCP_URL=
TERMINAL_SHARED_SECRET=
TERMINAL_EXECUTION_ENABLED=false
TERMINAL_AGENT_MAX_STEPS=12
TERMINAL_AGENT_TIMEOUT_SECONDS=600
TERMINAL_HOST=127.0.0.1
TERMINAL_PORT=8010
TERMINAL_BROKER_URL=http://127.0.0.1:8000
TERMINAL_EXECUTION_MODE=disabled
TERMINAL_WORKER_IMAGE=llm-terminal-worker:local
TERMINAL_WORKSPACE_HOST_PATH=
TERMINAL_JOB_TIMEOUT_SECONDS=300
TERMINAL_MAX_WORKSPACES_PER_USER=8
TERMINAL_WORKSPACE_TTL_SECONDS=86400

# 범용 MCP 앱: 자세한 설정과 권한 설명은 ASSISTANT.md를 참고하세요.
# MCP_SERVERS_JSON에는 서버 주소·허용 도구·사용자를, MCP_SECRETS_JSON에는 서버용 인증 키를 등록합니다.
MCP_SERVERS_JSON=[]
MCP_SECRETS_JSON={}

# 질문의 자동 처리: 연결된 내 GitLab과 접근 가능한 자료를 질문에 따라 사용합니다.
ASSISTANT_AUTOMATIC_ENABLED=true
# 사실 주장·소스 분석의 초안을 확인하고 근거 부족 시 문서를 다시 검색합니다. 완전한 오류 탐지를 보장하지는 않습니다.
ASSISTANT_GROUNDING_REVIEW=true
# 최초 답변을 포함한 최대 시도 횟수입니다. 재검색은 읽기 작업만 반복하며, 터미널 실행·외부 쓰기는 재실행하지 않습니다.
ASSISTANT_MAX_RETRIEVAL_ROUNDS=2
# 대화별 자동 처리·검색 방식은 채팅의 자료·앱 설정 모달에서 바꿀 수 있습니다.

# 문서·지식 검색과 색인: 기본은 SQLite 기반 키워드 검색이며 추가 모델·벡터 서버가 필요하지 않습니다.
KNOWLEDGE_ENABLED=true
# API가 자동으로 색인합니다. 전용 knowledge_main.py를 실행할 때 API에서는 false로 설정할 수 있습니다.
KNOWLEDGE_WORKER_ENABLED=true
# 설치된 Tesseract로 스캔 PDF와 이미지에서 글자를 읽습니다.
KNOWLEDGE_OCR_ENABLED=true
# 한글 언어 파일이 설치된 경우 kor+eng를 사용합니다.
KNOWLEDGE_OCR_LANGUAGES=eng
# 업로드 파일 하나는 기본 10MiB, 사용자별 원본 합계는 64MiB·100개까지 허용합니다.
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
KNOWLEDGE_MAX_USER_BYTES=67108864
KNOWLEDGE_MAX_DOCUMENTS=100

# 임베딩 모델: disabled는 키워드 검색, vllm 또는 ollama는 키워드·의미 검색을 결합합니다.
# 의미 검색에는 실제로 서빙 중인 임베딩 모델의 주소와 모델 ID가 모두 필요합니다.
KNOWLEDGE_EMBEDDING_PROVIDER=disabled
# vLLM 주소 예시: http://embedding.internal:8002/v1. 끝의 /embeddings는 앱이 붙입니다.
# Ollama 주소 예시: http://ollama.internal:11434. 끝의 /api/embed는 앱이 붙입니다.
KNOWLEDGE_EMBEDDING_URL=
# 임베딩 서버에서 제공하는 실제 모델 ID를 입력하세요.
KNOWLEDGE_EMBEDDING_MODEL=
# 임베딩 서버가 인증을 요구할 때만 입력합니다. 프론트엔드 환경 파일에는 저장하지 마세요.
KNOWLEDGE_EMBEDDING_KEY=

# 벡터 저장소·Qdrant: 기본 sqlite는 앱 DB에 벡터를 저장하며, 외부 Qdrant를 쓰려면 qdrant로 변경합니다.
# 사용 예시: KNOWLEDGE_VECTOR_STORE=qdrant
KNOWLEDGE_VECTOR_STORE=sqlite
# 같은 기기 예시: http://127.0.0.1:6333. 별도 Linux 서버나 Termux 원격 연결은 실제 서버 주소를 입력하세요.
# Compose를 사용하면 루트 .env를 설정하고 compose.knowledge.yaml의 내부 주소 지정을 따릅니다.
KNOWLEDGE_QDRANT_URL=
# Qdrant 서버의 API 키와 같은 값을 입력하세요. 이 값은 서버용이므로 프론트엔드에 넣지 마세요.
# Qdrant 사용 시 이 주소·키와 위 임베딩 모델 설정을 함께 입력한 뒤 백엔드를 재시작하세요.
KNOWLEDGE_QDRANT_KEY=
# 컬렉션 이름과 벡터 차원은 앱이 생성합니다. 설정을 바꾼 뒤 기존 자료는 지식 관리에서 재색인하세요.

# 검색 결과 재정렬은 선택 기능입니다. 비워 두면 추가 재정렬 서버를 호출하지 않습니다.
# 주소 예시: http://reranker.internal:8003. 끝의 /rerank는 앱이 붙입니다.
KNOWLEDGE_RERANK_URL=
KNOWLEDGE_RERANK_MODEL=
KNOWLEDGE_RERANK_KEY=
# 모델·임베딩·재정렬·Qdrant·범용 MCP의 사설 CA가 필요하면 실행 환경 내부 PEM 경로를 입력하세요.
ASSISTANT_CA_BUNDLE=

# PDF에 한글 글꼴을 포함하려면 백엔드에서 읽을 수 있는 한글 지원 TTF 파일의 절대 경로를 지정합니다.
# 비워 두면 기본 한국어 CID 글꼴을 사용하며, 문서 뷰어의 글꼴 지원에 따라 표시가 달라질 수 있습니다.
# Docker에서는 해당 글꼴 파일을 읽기 전용으로 마운트하고 컨테이너 내부 경로를 지정하세요.
ARTIFACT_PDF_FONT_PATH=
