FROM docker:28-cli AS dockercli
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates ripgrep && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home app
COPY --from=dockercli /usr/local/bin/docker /usr/local/bin/docker
COPY requirements*.txt ./
RUN pip install --no-cache-dir -r requirements-terminal.txt
COPY --chown=app:app terminal_mcp ./terminal_mcp
COPY --chown=app:app terminal_main.py ./
RUN mkdir -p /app/terminal-data && chown app:app /app/terminal-data
USER app
EXPOSE 8010
CMD ["python","terminal_main.py"]
