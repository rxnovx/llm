# Shared by backend (python main.py), frontend (npm run dev), and Compose.
# Generate each secret separately: python -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=development
JWT_SECRET_KEY=
AUTH_PROXY_SECRET=

# Local standalone defaults. Compose overrides the internal API address and bind host.
AUTH_SERVER_URL=http://127.0.0.1:8000
APP_URL=http://localhost:3000
# Extra exact browser origins, comma-separated. Leave empty for one public origin.
# Local alternative: http://127.0.0.1:3000. Keep deployment origins explicit.
APP_ALLOWED_ORIGINS=
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///./data/app.db
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_RELOAD=false
EXPOSE_DOCS=true
ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
PASSWORD_MIN_LENGTH=10
PUBLIC_REGISTRATION_ENABLED=true
AUTH_COOKIE_SECURE=false
AUTH_SERVER_TIMEOUT_MS=8000
# Leave empty for direct npm run dev. Compose sets x-real-ip from its Nginx.
AUTH_PROXY_CLIENT_IP_HEADER=

# Optional email / Google features. Core signup and password login need neither.
# For local email tests: EMAIL_PROVIDER=console (links appear in the API terminal).
# For delivery: EMAIL_PROVIDER=smtp, then supply SMTP settings.
EMAIL_PROVIDER=disabled
EMAIL_VERIFICATION_REQUIRED=false
EXPOSE_AUTH_TOKENS_IN_RESPONSE=false
EMAIL_FROM=LLM <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_HOSTED_DOMAIN=

# LLM chat: demo replies are local and never call an inference server.
LLM_TEST_MODE=true
LLM_CONNECTIONS_JSON=[]
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT_MS=150000

# Compose: Nginx is the public entry point. Set both URLs to its actual public origin.
HTTP_PORT=8080
FRONTEND_PORT=3000
API_PORT=8000
# Optional PostgreSQL override; use a URL-safe password such as token_hex(32).
POSTGRES_USER=llm
POSTGRES_DB=llm_accounts
POSTGRES_PASSWORD=
