# 개별 실행·Termux에서는 frontend/.env.local로 복사한 뒤 npm run dev를 재시작하세요.
# 저장소 루트의 python scripts/init_env.py --standalone으로 생성할 수도 있습니다.
# APP_URL은 사용자가 브라우저로 접속하는 대표 주소입니다.
APP_URL=http://localhost:3000
# 추가로 허용할 출처를 정확하게 입력하세요. 와일드카드는 허용하지 않습니다. 아래는 로컬 추가 주소입니다.
APP_ALLOWED_ORIGINS=http://127.0.0.1:3000
# Next.js 서버가 FastAPI에 연결하는 주소입니다. 비밀 값에는 NEXT_PUBLIC_ 접두사를 사용하지 마세요.
AUTH_SERVER_URL=http://127.0.0.1:8000
AUTH_SERVER_TIMEOUT_MS=8000
AUTH_COOKIE_SECURE=false
REFRESH_TOKEN_DAYS=14
# npm run dev로 직접 실행하면 IP 헤더는 비워 두세요. 신뢰할 수 있는 Nginx는 선택 사항입니다.
# IP 헤더를 사용하면 AUTH_PROXY_SECRET을 백엔드와 같은 값으로 설정해야 합니다.
AUTH_PROXY_SECRET=
AUTH_PROXY_CLIENT_IP_HEADER=
# 일반 추론과 Terminal 에이전트의 제한 시간(기본 600초)보다 여유 있게 긴 값으로 설정하세요. 단위는 밀리초입니다.
LLM_REQUEST_TIMEOUT_MS=900000

# GitLab OAuth와 채팅 화면은 같은 공개 출처를 사용합니다.
# GitLab에 APP_URL + /apps/gitlab/callback을 등록하고 백엔드의 FRONTEND_URL을 APP_URL과 맞추세요.
# OAuth 비밀 키와 토큰 암호화 키는 backend/.env에만 보관하고 NEXT_PUBLIC_ 접두사를 사용하지 마세요.

# Qdrant·임베딩·재정렬·MCP 인증 정보는 백엔드 전용 설정입니다.
# 개별 실행은 backend/.env.example을 참고하여 backend/.env에 입력하세요.
# Compose 실행은 루트 .env.example을 참고하여 루트 .env에 입력하세요.
# 필요한 항목: KNOWLEDGE_VECTOR_STORE, KNOWLEDGE_QDRANT_URL, KNOWLEDGE_QDRANT_KEY 및 KNOWLEDGE_EMBEDDING_*.
# 이 파일에 벡터 DB 주소·API 키를 복사하거나 NEXT_PUBLIC_ 변수로 공개하지 마세요.
