# Standalone / Termux: copy to frontend/.env.local, then restart npm run dev.
# Or run python scripts/init_env.py --standalone from the repository root.
# APP_URL is the canonical browser address, not the backend address.
APP_URL=http://localhost:3000
# Additional exact browser origins; no wildcards. Development loopback alias:
APP_ALLOWED_ORIGINS=http://127.0.0.1:3000
# Next.js connects to FastAPI on the server. Never use NEXT_PUBLIC_ for secrets.
AUTH_SERVER_URL=http://127.0.0.1:8000
AUTH_SERVER_TIMEOUT_MS=8000
AUTH_COOKIE_SECURE=false
REFRESH_TOKEN_DAYS=14
# Leave the IP header empty for direct npm run dev. A trusted Nginx is optional.
# If enabling it, AUTH_PROXY_SECRET must match the backend.
AUTH_PROXY_SECRET=
AUTH_PROXY_CLIENT_IP_HEADER=
# Must exceed backend queue wait + inference timeout, with a margin (30 + 120 seconds).
LLM_REQUEST_TIMEOUT_MS=180000

# GitLab uses the same public origin for OAuth and the chat UI.
# Register APP_URL + /apps/gitlab/callback in GitLab and set backend FRONTEND_URL=APP_URL.
# OAuth client secrets and token encryption keys go in backend/.env, never NEXT_PUBLIC_.
