{
  "name": "llm-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test:session": "node --test tests/auth-session.test.mjs",
    "test:proxy": "node --test tests/proxy.test.mjs",
    "test:env": "node --test tests/env.test.mjs",
    "test:chat": "node --experimental-strip-types --test tests/chat-stream.test.mjs",
    "test:markdown": "node --test tests/markdown.test.mjs",
    "test:api": "node --test tests/authenticated-fetch.test.mjs",
    "test:navigation": "node --experimental-strip-types --test tests/workspace-navigation.test.mjs",
    "test:browser": "playwright test",
    "predev": "node scripts/prepare-next-wasm.mjs",
    "prebuild": "node scripts/prepare-next-wasm.mjs",
    "test:portable": "node --test tests/termux-runtime.test.mjs"
  },
  "dependencies": {
    "axios": "^1.18.0",
    "katex": "^0.19.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "16.2.12",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
