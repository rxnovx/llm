# Host Nginx alternative: copy into /etc/nginx/sites-available/llm-accounts.
# Replace llm.example.com and certificate paths before enabling HTTPS.
# Adapted from rxnovx/my-note-app/nginx.config.file; no blog or collaboration routes.
server {
    listen 80;
    server_name llm.example.com;
    return 301 https://llm.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name llm.example.com;
    ssl_certificate /etc/letsencrypt/live/llm.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/llm.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;

    location / {
        # Compose web is bound to loopback; the bundled Nginx may be omitted.
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }
}
